{
  "id": "no.kristo.squeezebox",
  "version": "1.0.0",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Squeezebox (Lyrion)",
    "no": "Squeezebox (Lyrion)"
  },
  "description": {
    "en": "Control Squeezebox players via Lyrion Music Server",
    "no": "Styr Squeezebox-spillere via Lyrion Music Server"
  },
  "category": [
    "music"
  ],
  "permissions": [],
  "brandColor": "#E8501E",
  "author": {
    "name": "Sebastian Kristoffersen",
    "email": "sebastian@kristo.no"
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "icon": "/assets/icon.svg",
  "flow": {
    "triggers": [
      {
        "id": "track_changed",
        "title": {
          "en": "The track changed",
          "no": "Sporet endret seg"
        },
        "tokens": [
          {
            "name": "track",
            "type": "string",
            "title": {
              "en": "Track",
              "no": "Spor"
            },
            "example": "Bohemian Rhapsody"
          },
          {
            "name": "artist",
            "type": "string",
            "title": {
              "en": "Artist",
              "no": "Artist"
            },
            "example": "Queen"
          },
          {
            "name": "album",
            "type": "string",
            "title": {
              "en": "Album",
              "no": "Album"
            },
            "example": "A Night at the Opera"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "play_favorite",
        "title": {
          "en": "Play favorite",
          "no": "Spill favoritt"
        },
        "titleFormatted": {
          "en": "Play favorite [[favorite]]",
          "no": "Spill favoritt [[favorite]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "autocomplete",
            "name": "favorite",
            "placeholder": {
              "en": "Favorite",
              "no": "Favoritt"
            }
          }
        ]
      },
      {
        "id": "play_preset",
        "title": {
          "en": "Play preset",
          "no": "Spill preset"
        },
        "titleFormatted": {
          "en": "Play preset [[preset]]",
          "no": "Spill preset [[preset]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "dropdown",
            "name": "preset",
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "1"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "2"
                }
              },
              {
                "id": "3",
                "label": {
                  "en": "3"
                }
              },
              {
                "id": "4",
                "label": {
                  "en": "4"
                }
              },
              {
                "id": "5",
                "label": {
                  "en": "5"
                }
              },
              {
                "id": "6",
                "label": {
                  "en": "6"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "play_url",
        "title": {
          "en": "Play URL",
          "no": "Spill URL"
        },
        "titleFormatted": {
          "en": "Play URL [[url]]",
          "no": "Spill URL [[url]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "text",
            "name": "url",
            "placeholder": {
              "en": "http://stream.example/radio.mp3"
            }
          }
        ]
      },
      {
        "id": "sync_to",
        "title": {
          "en": "Sync with player",
          "no": "Synkroniser med spiller"
        },
        "titleFormatted": {
          "en": "Sync with [[target]]",
          "no": "Synkroniser med [[target]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "autocomplete",
            "name": "target",
            "placeholder": {
              "en": "Player",
              "no": "Spiller"
            }
          }
        ]
      },
      {
        "id": "unsync",
        "title": {
          "en": "Unsync player",
          "no": "Fjern synkronisering"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "squeezebox_radio",
      "name": {
        "en": "Squeezebox Radio",
        "no": "Squeezebox Radio"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_next",
        "speaker_prev",
        "volume_set",
        "volume_mute",
        "speaker_artist",
        "speaker_album",
        "speaker_track",
        "preset_1",
        "preset_2",
        "preset_3",
        "preset_4",
        "preset_5",
        "preset_6"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/squeezebox_radio/assets/images/small.png",
        "large": "/drivers/squeezebox_radio/assets/images/large.png",
        "xlarge": "/drivers/squeezebox_radio/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "squeezebox_boom",
      "name": {
        "en": "Squeezebox Boom",
        "no": "Squeezebox Boom"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_next",
        "speaker_prev",
        "volume_set",
        "volume_mute",
        "speaker_artist",
        "speaker_album",
        "speaker_track",
        "preset_1",
        "preset_2",
        "preset_3",
        "preset_4",
        "preset_5",
        "preset_6"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/squeezebox_boom/assets/images/small.png",
        "large": "/drivers/squeezebox_boom/assets/images/large.png",
        "xlarge": "/drivers/squeezebox_boom/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "squeezebox_touch",
      "name": {
        "en": "Squeezebox Touch",
        "no": "Squeezebox Touch"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_next",
        "speaker_prev",
        "volume_set",
        "volume_mute",
        "speaker_artist",
        "speaker_album",
        "speaker_track",
        "preset_1",
        "preset_2",
        "preset_3",
        "preset_4",
        "preset_5",
        "preset_6"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/squeezebox_touch/assets/images/small.png",
        "large": "/drivers/squeezebox_touch/assets/images/large.png",
        "xlarge": "/drivers/squeezebox_touch/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    },
    {
      "id": "squeezebox",
      "name": {
        "en": "Other Squeezebox player",
        "no": "Annen Squeezebox-spiller"
      },
      "class": "speaker",
      "capabilities": [
        "onoff",
        "speaker_playing",
        "speaker_next",
        "speaker_prev",
        "volume_set",
        "volume_mute",
        "speaker_artist",
        "speaker_album",
        "speaker_track",
        "preset_1",
        "preset_2",
        "preset_3",
        "preset_4",
        "preset_5",
        "preset_6"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/squeezebox/assets/images/small.png",
        "large": "/drivers/squeezebox/assets/images/large.png",
        "xlarge": "/drivers/squeezebox/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ],
  "capabilities": {
    "preset_1": {
      "type": "boolean",
      "title": {
        "en": "Preset 1",
        "no": "Preset 1"
      },
      "getable": false,
      "setable": true,
      "uiComponent": "button",
      "uiQuickAction": false
    },
    "preset_2": {
