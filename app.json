{
  "id": "no.kristo.squeezebox",
  "version": "1.0.3",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Squeezebox (Lyrion)",
    "no": "Squeezebox (Lyrion)"
  },
  "description": {
    "en": "Unofficial app for Squeezebox players on Lyrion Music Server",
    "no": "Uoffisiell app for Squeezebox-spillere med Lyrion Music Server"
  },
  "category": [
    "music"
  ],
  "tags": {
    "en": [
      "squeezebox",
      "lyrion",
      "logitech media server",
      "lms",
      "squeezelite",
      "music",
      "radio"
    ],
    "no": [
      "squeezebox",
      "lyrion",
      "logitech media server",
      "lms",
      "musikk",
      "radio"
    ]
  },
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "icon": "/assets/icon.svg",
  "author": {
    "name": "Sebastian Kristo Jemtland",
    "email": "sebastian@kristo.no"
  },
  "brandColor": "#24292E",
  "source": "https://github.com/SebastianKristo/homey-squeezebox",
  "homepage": "https://github.com/SebastianKristo/homey-squeezebox",
  "support": "https://github.com/SebastianKristo/homey-squeezebox/issues",
  "bugs": {
    "url": "https://github.com/SebastianKristo/homey-squeezebox/issues"
  },
  "flow": {
    "triggers": [
      {
        "id": "track_changed",
        "title": {
          "en": "The track changed",
          "no": "Sporet endret seg"
        },
        "tokens": [
          {
            "name": "track",
            "type": "string",
            "title": {
              "en": "Track",
              "no": "Spor"
            },
            "example": "Bohemian Rhapsody"
          },
          {
            "name": "artist",
            "type": "string",
            "title": {
              "en": "Artist",
              "no": "Artist"
            },
            "example": "Queen"
          },
          {
            "name": "album",
            "type": "string",
            "title": {
              "en": "Album",
              "no": "Album"
            },
            "example": "A Night at the Opera"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      },
      {
        "id": "alarm_started",
        "title": {
          "en": "An alarm went off",
          "no": "En alarm startet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      },
      {
        "id": "alarm_snoozed",
        "title": {
          "en": "An alarm was snoozed",
          "no": "En alarm ble slumret"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      },
      {
        "id": "alarm_ended",
        "title": {
          "en": "An alarm ended",
          "no": "En alarm stoppet"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "play_favorite",
        "title": {
          "en": "Play favorite",
          "no": "Spill favoritt"
        },
        "titleFormatted": {
          "en": "Play favorite [[favorite]]",
          "no": "Spill favoritt [[favorite]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "autocomplete",
            "name": "favorite",
            "placeholder": {
              "en": "Favorite",
              "no": "Favoritt"
            }
          }
        ]
      },
      {
        "id": "play_preset",
        "title": {
          "en": "Play preset",
          "no": "Spill preset"
        },
        "titleFormatted": {
          "en": "Play preset [[preset]]",
          "no": "Spill preset [[preset]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "dropdown",
            "name": "preset",
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "1"
                }
              },
              {
                "id": "2",
                "label": {
                  "en": "2"
                }
              },
              {
                "id": "3",
                "label": {
                  "en": "3"
                }
              },
              {
                "id": "4",
                "label": {
                  "en": "4"
                }
              },
              {
                "id": "5",
                "label": {
                  "en": "5"
                }
              },
              {
                "id": "6",
                "label": {
                  "en": "6"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "play_url",
        "title": {
          "en": "Play URL",
          "no": "Spill URL"
        },
        "titleFormatted": {
          "en": "Play URL [[url]]",
          "no": "Spill URL [[url]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "text",
            "name": "url",
            "placeholder": {
              "en": "http://stream.example/radio.mp3"
            }
          }
        ]
      },
      {
        "id": "sync_to",
        "title": {
          "en": "Sync with player",
          "no": "Synkroniser med spiller"
        },
        "titleFormatted": {
          "en": "Sync with [[target]]",
          "no": "Synkroniser med [[target]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "autocomplete",
            "name": "target",
            "placeholder": {
              "en": "Player",
              "no": "Spiller"
            }
          }
        ]
      },
      {
        "id": "unsync",
        "title": {
          "en": "Unsync player",
          "no": "Fjern synkronisering"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          }
        ]
      },
      {
        "id": "set_alarms_enabled",
        "title": {
          "en": "Turn alarms on or off",
          "no": "Slå alarmer av eller på"
        },
        "titleFormatted": {
          "en": "Turn alarms [[state]]",
          "no": "Slå alarmer [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=squeezebox|squeezebox_radio|squeezebox_boom|squeezebox_touch"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "1",
                "label": {
                  "en": "on",
                  "no": "på"
                }
              },
              {
                "id": "0",
                "label": {
                  "en": "off",
                  "no": "av"
                }
              }
            ]
          }
        ]
      }
    ]
  },
