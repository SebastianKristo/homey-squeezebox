  "api": {
    "getServers": {
      "method": "GET",
      "path": "/servers"
    },
    "updateServer": {
      "method": "PUT",
      "path": "/servers/:id"
    },
    "deleteServer": {
      "method": "DELETE",
      "path": "/servers/:id"
    },
    "addServer": {
      "method": "POST",
      "path": "/servers"
    },
    "discoverServers": {
      "method": "POST",
      "path": "/discover"
    }
